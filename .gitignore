# macOS
.DS_Store

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Build artifacts (one dir per imager target — they must not share an output
# path: a second target would clobber a tar a `crane push` is still reading)
/_out-cpu/
/_out-gpu/
/_out-iso/

# Local cluster credentials and configs (never committed)
/kubeconfig
*.kubeconfig
/talosconfig
*.talosconfig
/controlplane.yaml
/worker.yaml
/talos-*/

# Local working notes and operational scratch (untracked)
/CLAUDE.md
/.claude/
/ops/
